# Local Postgres from docker-compose.yml (npm run db:up)
DATABASE_URL="postgresql://saksham:saksham@localhost:5432/saksham?schema=public"

# Separate database for `npm test`. It is wiped on every test run.
TEST_DATABASE_URL="postgresql://saksham:saksham@localhost:5432/saksham_test?schema=public"

# Online payments: "test" = built-in test checkout for QA (no real money), "cashfree" = real gateway (not wired yet), unset = off.
PAYMENT_PROVIDER="test"

# Daily job (reminders, overdue marking): the scheduler calls POST /api/v1/cron/daily with "Authorization: Bearer <this>".
# Use a long random value in production. Unset = the cron endpoint is off (the super admin can still run it by hand).
CRON_SECRET="dev-cron-secret-change-me"

# Testing before SMS is set up: "true" shows each one-time code on the login, join and enrol screens.
# Ignored when the app runs in production mode. Remove it (or set "false") once MSG91 is configured.
SHOW_OTP_ON_SCREEN="false"
