generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id        String     @id @default(cuid())
  phone     String     @unique // 10-digit Indian mobile, no +91
  name      String
  role      Role       @default(MEMBER)
  language  String     @default("hi")
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  sessions  Session[]

  agentProfile  AgentProfile?
  memberProfile MemberProfile?
}

model AgentProfile {
  userId        String  @id
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  panchayat     String
  pan           String?
  payoutDetails Json? // bank account / UPI
  approved      Boolean @default(false)
}

model MemberProfile {
  userId  String  @id
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  address String
  village String
  nominee String?
}

enum SchemeCode {
  UPAHAR
  MANPASAND
  GOLD
}

model Scheme {
  id                String     @id @default(cuid())
  code              SchemeCode @unique
  nameEn            String
  nameHi            String
  installmentAmount Int // paise
  tenureMonths      Int
  commissionRule    Json // { type: "TIER", tiers } | { type: "FLAT", amount } | { type: "PERCENT", bps }
  batches           Batch[]
}

enum BatchStatus {
  OPEN // taking enrolments
  RUNNING
  CLOSED
}

model Batch {
  id             String      @id @default(cuid())
  schemeId       String
  scheme         Scheme      @relation(fields: [schemeId], references: [id])
  number         Int // 3 → "B03" in token numbers
  startMonth     DateTime    @db.Date // first day of the month of installment 1
  size           Int
  winnersPerDraw Int
  status         BatchStatus @default(OPEN)

  @@unique([schemeId, number])
}

// Business settings that admins can change. Values are JSON; money in paise, percentages in basis points.
model Config {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  device    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// One live code per phone; replaced on every new request.
model OtpCode {
  phone     String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}
