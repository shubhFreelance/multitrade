generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id        String     @id @default(cuid())
  phone     String     @unique // 10-digit Indian mobile, no +91
  name      String
  role      Role       @default(MEMBER)
  language  String     @default("hi")
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  sessions  Session[]

  agentProfile  AgentProfile?
  memberProfile MemberProfile?
  auditLogs     AuditLog[]

  enrolments      Enrolment[] @relation("MemberEnrolments")
  agentEnrolments Enrolment[] @relation("AgentEnrolments")
  payments        Payment[]   @relation("MemberPayments")
}

model AgentProfile {
  userId        String  @id
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  panchayat     String
  pan           String?
  payoutDetails Json? // bank account / UPI
  approved      Boolean @default(false)
}

model MemberProfile {
  userId  String  @id
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  address String
  village String
  nominee String?
}

enum SchemeCode {
  UPAHAR
  MANPASAND
  GOLD
}

model Scheme {
  id                String     @id @default(cuid())
  code              SchemeCode @unique
  nameEn            String
  nameHi            String
  installmentAmount Int // paise
  tenureMonths      Int
  commissionRule    Json // { type: "TIER", tiers } | { type: "FLAT", amount } | { type: "PERCENT", bps }
  batches           Batch[]
}

enum BatchStatus {
  OPEN // taking enrolments
  RUNNING
  CLOSED
}

model Batch {
  id             String      @id @default(cuid())
  schemeId       String
  scheme         Scheme      @relation(fields: [schemeId], references: [id])
  number         Int // 3 → "B03" in token numbers
  startMonth     DateTime    @db.Date // first day of the month of installment 1
  size           Int
  winnersPerDraw Int
  status         BatchStatus @default(OPEN)
  enrolments     Enrolment[]

  @@unique([schemeId, number])
}

// Business settings that admins can change. Values are JSON; money in paise, percentages in basis points.
model Config {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  device    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum OtpPurpose {
  LOGIN
  ENROL // member confirms an enrolment an agent started
}

// One live code per phone and purpose; replaced on every new request.
model OtpCode {
  phone     String
  purpose   OtpPurpose @default(LOGIN)
  context   String     @default("") // what the code approves, e.g. the batch id for ENROL
  codeHash  String
  expiresAt DateTime
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  @@id([phone, purpose])
}

model Product {
  id        String       @id @default(cuid())
  name      String
  nameHi    String?
  price     Int // paise
  schemes   SchemeCode[]
  stock     Int          @default(0)
  active    Boolean      @default(true) // inactive instead of deleted: fulfilments will reference products
  createdAt DateTime     @default(now())
}

// Who did what, for admin actions, cash verification, draws, payouts and manual edits.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String // e.g. "batch.update"
  entity    String
  entityId  String
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

enum EnrolmentStatus {
  ACTIVE
  MATURED
  DEFAULTED
}

// One member in one batch. A member can have several.
model Enrolment {
  id           String          @id @default(cuid())
  memberId     String
  member       User            @relation("MemberEnrolments", fields: [memberId], references: [id])
  agentId      String
  agent        User            @relation("AgentEnrolments", fields: [agentId], references: [id])
  batchId      String
  batch        Batch           @relation(fields: [batchId], references: [id])
  seq          Int // 457 → token ...-0457
  tokenNumber  String          @unique
  status       EnrolmentStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  installments Installment[]

  @@unique([batchId, seq])
  @@index([memberId])
  @@index([agentId])
}

enum InstallmentStatus {
  DUE
  PAID
  OVERDUE
  WAIVED
}

model Installment {
  id          String            @id @default(cuid())
  enrolmentId String
  enrolment   Enrolment         @relation(fields: [enrolmentId], references: [id])
  monthNo     Int // 1..tenure
  dueDate     DateTime          @db.Date
  amount      Int // paise, copied from the scheme at enrolment
  status      InstallmentStatus @default(DUE)
  payments    Payment[]

  @@unique([enrolmentId, monthNo])
}

enum PaymentMethod {
  ONLINE
  CASH
}

enum PaymentStatus {
  CREATED // order made, member not yet paid
  SUCCESS
  FAILED
  DUPLICATE // money received for an installment that was already paid: admin must refund
}

// One attempt to pay one installment. Online orders are confirmed by the gateway (or the test provider).
model Payment {
  id               String        @id @default(cuid())
  installmentId    String
  installment      Installment   @relation(fields: [installmentId], references: [id])
  memberId         String
  member           User          @relation("MemberPayments", fields: [memberId], references: [id])
  method           PaymentMethod
  provider         String // "TEST" or "CASHFREE"
  amount           Int // paise
  orderId          String        @unique // our order id, sent to the gateway
  gatewayPaymentId String?       @unique // the gateway's payment id; unique so one payment never counts twice
  status           PaymentStatus @default(CREATED)
  createdAt        DateTime      @default(now())
  paidAt           DateTime?

  @@index([installmentId])
  @@index([memberId])
}
